# DISPO OPS Cloud Functions settings (not secrets). The one-way sync into the Universal Team Hub (the hub mirrors each
# deal): set to false and redeploy the functions to switch it off. It needs the HUB_SYNC_SECRET secret in Google Cloud.
HUB_SYNC_ENABLED=true
HUB_URL=https://hub.totalchb.com
APP_URL=https://dispo-ops.totalchb.com
